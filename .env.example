# Token du bot Telegram (via @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Optionnel : clé API OpenAgenda (https://openagenda.com → paramètres)
# Sans clé, le bot utilise un catalogue local de lieux + suggestions
OPENAGENDA_API_KEY=

# Rayon max en km autour de Montpellier (défaut 50 pour inclure Nîmes / Lodève / Sète)
RADIUS_KM=50
